"""Smoke test — app factory is wired correctly."""

from fastapi.testclient import TestClient

from src.api.app import create_app
from src.core.settings import Settings, get_settings


def test_root_endpoint_returns_service_name() -> None:
    """The placeholder ``/api/`` endpoint returns the project name."""
    app = create_app()
    with TestClient(app) as client:
        response = client.get("/api/")
    assert response.status_code == 200
    assert response.json() == {"service": "__PROJECT_NAME__"}


def test_settings_are_replaceable_through_dependency_overrides() -> None:
    """A factory reads settings through ``Depends(get_settings)``.

    So overriding ``get_settings`` changes what the endpoint answers
    without touching the router, the controller or the environment.
    """
    app = create_app()
    app.dependency_overrides[get_settings] = lambda: Settings(TITLE="overridden")
    with TestClient(app) as client:
        response = client.get("/api/")
    assert response.status_code == 200
    assert response.json() == {"service": "overridden"}


def test_liveness_endpoint_is_up() -> None:
    """The SDK health router exposes ``GET /health/liveness``."""
    app = create_app()
    with TestClient(app) as client:
        response = client.get("/health/liveness")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}
