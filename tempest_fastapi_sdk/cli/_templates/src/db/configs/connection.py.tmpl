"""Builds the process's database manager — the one place the engine is configured.

``src.api.dependencies.resources`` calls :func:`make_db_manager` once per
process; a script or a test that needs its own manager calls it too, so
every engine of the project is built with the same options.

``hide_parameters=True`` keeps the bind parameters out of the text of
every SQLAlchemy exception. Without it, an ``IntegrityError`` that is
logged or reaches the 500 handler writes ``[parameters: (...)]`` with the
row's e-mail, document number or password hash.

This module imports nothing from the project, on purpose: ``src.db.models``
imports this package for the table names, and a project import here
would build the settings every time Alembic loads the models.
"""

from __future__ import annotations

from tempest_fastapi_sdk import AsyncDatabaseManager, DatabaseSettings


def make_db_manager(settings: DatabaseSettings) -> AsyncDatabaseManager:
    """Build the database manager for the given settings.

    Args:
        settings (DatabaseSettings): Settings composing the SDK's
            ``DatabaseSettings`` mixin — the project's ``Settings``.

    Returns:
        AsyncDatabaseManager: A manager that is not connected yet, with
        the bind parameters out of the error messages.
    """
    return AsyncDatabaseManager(**settings.database_kwargs(), hide_parameters=True)


__all__: list[str] = ["make_db_manager"]
