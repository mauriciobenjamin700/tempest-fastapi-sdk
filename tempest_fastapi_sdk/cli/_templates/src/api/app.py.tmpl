from src.api.dependencies import db
from src.core.settings import settings
@@if admin@@
from src.db.models import UserModel
@@endif@@

ALEMBIC_INI: Path = Path(__file__).resolve().parents[2] / "alembic.ini"
"""Absolute path of the project's ``alembic.ini``.

Absolute so the lifespan finds it whatever directory the process was
started from; the ini anchors its own paths on ``%(here)s``.
"""

configure_logging(
    level=settings.LOG_LEVEL,
    json_output=settings.LOG_JSON,
    log_dir=settings.LOG_DIR,
)


@asynccontextmanager
async def lifespan(_: FastAPI) -> AsyncGenerator[None, None]:
    """Migrate the schema, then open and close shared resources.

    ``sync_schema_async`` handles the three states a database can be in:
    empty (runs every revision), created before Alembic (stamps the
    baseline, then upgrades) and already migrated (upgrades). It refuses
    a pending migration that drops a table, column or constraint. Set
    ``DATABASE_MIGRATE_ON_STARTUP=false`` when several replicas start
    together and a one-off job runs ``tempest db upgrade`` instead.
    """
    if settings.DATABASE_MIGRATE_ON_STARTUP:
        await AlembicHelper(
            str(ALEMBIC_INI),
            db_url=settings.DATABASE_URL,
        ).sync_schema_async()
    await db.connect()
    try:
        yield
    finally:
        await db.disconnect()


def create_app() -> FastAPI:
    """Build the configured FastAPI instance.

    ``/logs`` is mounted only when ``TOKEN_SECRET`` is set:
    ``make_logs_router`` refuses an empty secret, and the generated
    ``.env.example`` ships ``TOKEN_SECRET=`` empty. Fill it with
    ``uv run tempest secrets init`` to get the endpoint.
@@if admin@@

    The admin panel needs the ``[admin]`` extra and a ``UserModel`` row
    with ``is_admin=True``; create one with
    ``uv run tempest user create --email <you> --admin``.
@@endif@@

    Returns:
        FastAPI: A fully wired application ready for uvicorn.
    """
    app = FastAPI(
        title=settings.TITLE,
        description=settings.DESCRIPTION,
        version=settings.VERSION,
        lifespan=lifespan,
    )

    app.add_middleware(RequestIDMiddleware)
    apply_cors(app, settings)
    register_exception_handlers(app)

    app.include_router(
        make_health_router(db=db, version=settings.VERSION),
    )
    if settings.TOKEN_SECRET.strip():
        app.include_router(
            make_logs_router(
                log_dir=settings.LOG_DIR,
                token_secret=settings.TOKEN_SECRET,
            ),
        )
@@if admin@@

    admin_site = AdminSite(title=f"{settings.TITLE} admin")
    admin_site.register(AdminModel(model=UserModel))
    app.include_router(
        make_admin_router(
            admin_site,
            db=db,
            auth_backend=UserModelAuthBackend(user_model=UserModel),
            secret_key=settings.JWT_SECRET,
            cookie_secure=not settings.SERVER_DEBUG,
            show_logs=True,
            log_dir=settings.LOG_DIR,
        ),
    )
@@endif@@

    from src.api.routers import router as api_router

    app.include_router(api_router, prefix="/api")

    return app
