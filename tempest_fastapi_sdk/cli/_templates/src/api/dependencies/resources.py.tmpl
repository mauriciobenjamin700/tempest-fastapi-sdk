"""Shared infrastructure singletons + their FastAPI ``Depends`` providers.

Resources (the database, plus object storage with ``[minio]`` and the
mailer with ``[email]``) are built **once** here and reached everywhere
through ``get_*`` dependencies. This keeps ``app.py`` thin (middleware +
handlers + router wiring only) and gives the service a single place that
owns resource construction and lifecycle.

Each ``*_kwargs()`` mapper on the settings translates the env vars into
the constructor's arguments, so building a client is a splat. A factory
in :mod:`src.api.dependencies.controllers` receives these through
``Depends`` rather than importing the singletons, which is what lets a
test replace one with ``app.dependency_overrides``.
"""

from __future__ import annotations

from tempest_fastapi_sdk import (
    AsyncDatabaseManager,
@@if minio@@
    AsyncMinIOClient,
@@endif@@
@@if email@@
    EmailUtils,
@@endif@@
)

from src.core.settings import settings

db: AsyncDatabaseManager = AsyncDatabaseManager(**settings.database_kwargs())
"""One database manager per process, connected during the app lifespan."""

get_session = db.session_dependency
"""Request-scoped ``AsyncSession`` dependency.

Declare it as ``session: AsyncSession = Depends(get_session)`` in a
dependency factory; the session is closed when the request ends.
"""


def get_db() -> AsyncDatabaseManager:
    """Return the process-wide database manager.

    Returns:
        AsyncDatabaseManager: The shared manager (connected during the
        app lifespan).
    """
    return db
@@if minio@@


storage: AsyncMinIOClient = AsyncMinIOClient(**settings.storage_kwargs())
"""The process-wide MinIO / S3 client, built from the ``STORAGE_*`` settings."""


def get_storage() -> AsyncMinIOClient:
    """Return the shared MinIO / S3 client.

    Returns:
        AsyncMinIOClient: The client built from the ``STORAGE_*`` settings.
    """
    return storage
@@endif@@
@@if email@@


mailer: EmailUtils = EmailUtils(**settings.email_kwargs())
"""The process-wide transactional-email helper, built from ``SMTP_*``."""


def get_mailer() -> EmailUtils:
    """Return the shared transactional-email helper.

    Returns:
        EmailUtils: The helper built from the ``SMTP_*`` settings.
    """
    return mailer
@@endif@@


__all__: list[str] = [
    "db",
    "get_db",
@@if email@@
    "get_mailer",
@@endif@@
    "get_session",
@@if minio@@
    "get_storage",
@@endif@@
@@if email@@
    "mailer",
@@endif@@
@@if minio@@
    "storage",
@@endif@@
]
