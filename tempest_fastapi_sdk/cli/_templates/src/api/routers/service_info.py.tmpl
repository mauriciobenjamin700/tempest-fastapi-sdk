"""``GET /api/`` — the placeholder root endpoint, one router per module.

A domain router is a :class:`~tempest_fastapi_sdk.TempestAPIRouter`, not
a plain ``fastapi.APIRouter``: it turns the ``@raises(...)`` under each
route decorator into that route's error ``responses=`` (a plain
``APIRouter`` ignores the tag, and ``tempest check`` reports one here as
``RTR005``). The OpenAPI text of each route lives in
``src/api/docs/service_info.py`` and is spread into the decorator.
"""

from __future__ import annotations

from fastapi import Depends
from tempest_fastapi_sdk import TempestAPIRouter

from src.api.dependencies import get_service_info_controller
from src.api.docs import service_info
from src.controllers import ServiceInfoController
from src.schemas import ServiceInfoSchema

router: TempestAPIRouter = TempestAPIRouter(tags=["root"])


@router.get("/", **service_info.INDEX)
async def index(
    controller: ServiceInfoController = Depends(get_service_info_controller),
) -> ServiceInfoSchema:
    """Placeholder root endpoint returning the service name.

    Args:
        controller (ServiceInfoController): Built per request by
            :func:`~src.api.dependencies.get_service_info_controller`.

    Returns:
        ServiceInfoSchema: The service title.
    """
    return await controller.describe()


__all__: list[str] = ["router"]
