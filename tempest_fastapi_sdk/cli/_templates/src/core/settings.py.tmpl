"""Application settings — composed from SDK mixins + service overrides."""

from __future__ import annotations

from functools import lru_cache
from pathlib import Path

from pydantic import Field
from tempest_fastapi_sdk import (
    BaseAppSettings,
    CORSSettings,
    DatabaseSettings,
@@if email@@
    EmailSettings,
@@endif@@
    EnvironmentSettings,
@@if auth@@
    JWTSettings,
@@endif@@
    LogSettings,
    ServerSettings,
@@if minio@@
    StorageSettings,
@@endif@@
@@if taskiq@@
    TaskIQSettings,
@@endif@@
    TokenSettings,
    read_project_version,
)

PYPROJECT_PATH: Path = Path(__file__).resolve().parents[2] / "pyproject.toml"
"""Absolute path of the project's ``pyproject.toml``.

Anchored on this file, not on the working directory: the app lifespan and
Alembic can run from another directory, and the version must still come
from the project that owns this settings module.
"""


class Settings(
    EnvironmentSettings,
    ServerSettings,
    LogSettings,
    DatabaseSettings,
@@if auth@@
    JWTSettings,
@@endif@@
    TokenSettings,
    CORSSettings,
@@if email@@
    EmailSettings,
@@endif@@
@@if minio@@
    StorageSettings,
@@endif@@
@@if taskiq@@
    TaskIQSettings,
@@endif@@
    BaseAppSettings,
):
    """Service-wide settings backed by the ``.env`` file.

    ``ENV=production`` refuses to boot while a mixin still holds a
    development value (SQLite, an empty ``TOKEN_SECRET``, CORS ``*``,
    debug/reload, and each mixin's own placeholder).

    Attributes:
        TITLE (str): API title shown in the OpenAPI docs and the admin
            panel header. Override via the ``TITLE`` env var.
        DESCRIPTION (str): Optional API description shown in the OpenAPI
            docs. Override via the ``DESCRIPTION`` env var.
        VERSION (str): Version surfaced in the OpenAPI docs and on the
            health router. Read from ``[project].version`` in
            ``pyproject.toml`` — the single source of truth — unless the
            ``VERSION`` env var overrides it.
        DATABASE_MIGRATE_ON_STARTUP (bool): Apply pending migrations in
            the app lifespan. Turn off when a separate job migrates.
@@if tasks-redis@@
        TASKIQ_BROKER_URL (str): TaskIQ broker. Defaults to the local
            Redis, because the project pins ``[tasks-redis]``: the mixin's
            own default is an ``amqp://`` URL, which selects RabbitMQ and
            needs ``[tasks]``, so importing ``src.tasks`` without a
            ``.env`` would fail.
@@endif@@
    """

    TITLE: str = Field(
        default="__PROJECT_NAME__",
        title="API title",
        description="Shown in the OpenAPI docs and the admin panel header.",
        examples=["__PROJECT_NAME__"],
    )
    DESCRIPTION: str = Field(
        default="",
        title="API description",
        description="Optional summary shown in the OpenAPI docs.",
        examples=["Backend API for __PROJECT_NAME__."],
    )
    VERSION: str = Field(
        default_factory=lambda: read_project_version(PYPROJECT_PATH),
        title="API version",
        description=(
            "Surfaced in the OpenAPI docs and the health router. Defaults "
            "to [project].version in pyproject.toml; set the VERSION env "
            "var to override it."
        ),
        examples=["0.1.0"],
    )
    DATABASE_MIGRATE_ON_STARTUP: bool = Field(
        default=True,
        title="Migrate on startup",
        description=(
            "Apply pending Alembic migrations in the app lifespan. Turn off "
            "when several replicas start together and a job migrates."
        ),
        examples=[True, False],
    )
@@if tasks-redis@@
    TASKIQ_BROKER_URL: str = Field(
        default="redis://localhost:6379/0",
        title="TaskIQ broker URL",
        description=(
            "redis:// selects Redis Streams ([tasks-redis]); empty selects "
            "the in-memory broker."
        ),
        examples=["redis://localhost:6379/0", ""],
    )
@@endif@@


@lru_cache
def get_settings() -> Settings:
    """Return the process-wide settings, built once from the environment.

    Declare ``settings: Settings = Depends(get_settings)`` in a
    dependency factory instead of importing :data:`settings` there: a
    test then swaps the values with
    ``app.dependency_overrides[get_settings] = lambda: Settings(...)``
    without touching routers, controllers or services. The cache makes
    every call return the same instance; ``get_settings.cache_clear()``
    drops it so the next call re-reads the environment.

    Returns:
        Settings: The cached instance.
    """
    return Settings()


settings: Settings = get_settings()
"""The same instance :func:`get_settings` returns.

Kept for import-time wiring that runs outside a request — the resource
singletons, logging, the lifespan, ``server.py`` and Alembic's
``env.py`` — where there is no ``Depends`` to resolve.
"""


__all__: list[str] = ["Settings", "get_settings", "settings"]
